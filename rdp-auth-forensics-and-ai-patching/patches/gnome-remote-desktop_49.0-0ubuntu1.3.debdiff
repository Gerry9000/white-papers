+--- gnome-remote-desktop-49.0.orig/data/gnome-remote-desktop-handover.service.in
++++ gnome-remote-desktop-49.0/data/gnome-remote-desktop-handover.service.in
+@@ -1,5 +1,10 @@
+ [Unit]
+ Description=GNOME Remote Desktop Handover
++# Prevent gsd-sharing from stopping the handover service on the login screen.
++# gsd-sharing calls DisableService when enabled-connections is empty for the
++# gdm greeter user, but the handover daemon must remain active in greeter
++# sessions for the system daemon's server redirection to complete.
++RefuseManualStop=yes
+ 
+ [Service]
+ Type=dbus
