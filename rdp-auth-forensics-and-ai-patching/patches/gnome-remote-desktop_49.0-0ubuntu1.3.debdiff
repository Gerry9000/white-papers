++#: src/org.gnome.desktop.remote-desktop.gschema.xml.in:132
++msgid ""
++"When view-only is true, remote VNC connections cannot manipulate input "
++"devices (e.g. mouse and keyboard)."
++msgstr ""
++
++#: src/org.gnome.desktop.remote-desktop.gschema.xml.in:139
++msgid "Method used to authenticate VNC connections"
++msgstr ""
++
++#: src/org.gnome.desktop.remote-desktop.gschema.xml.in:140
++msgid ""
++"The VNC authentication method describes how a remote connection is "
++"authenticated. It can currently be done in two different ways: * prompt - by "
++"prompting the user for each new connection, requiring a person with physical "
++"access to the workstation to explicitly approve the new connection. * "
++"password - by requiring the remote client to provide a known password"
++msgstr ""
++
++#: src/org.gnome.desktop.remote-desktop.gschema.xml.in:152
++msgid "Screenshare mode of VNC connections"
++msgstr ""
++
++#: src/org.gnome.desktop.remote-desktop.gschema.xml.in:153
++msgid ""
++"The screenshare mode specifies, whether the VNC backend mirrors the primary "
++"screen, or whether a virtual monitor is created. For the initial resolution "
++"of the virtual monitor, the VNC backend uses a default size of 1920x1080 "
++"pixels. When using a remote desktop session with a virtual monitor, clients "
++"can resize the resolution of the virtual monitor during a session with the "
++"setDesktopSize PDU. Allowed screenshare modes include: * mirror-primary - "
++"Record the primary monitor of the current user session. * extend - Create a "
++"new virtual monitor and use it for the remote desktop session. The initial "
++"monitor resolution of this virtual monitor is set to 1920x1080 pixels. "
++"Clients can override the initial resolution with subsequent monitor "
++"configuration updates."
++msgstr ""
+--- gnome-remote-desktop-49.0.orig/src/grd-daemon-handover.c
++++ gnome-remote-desktop-49.0/src/grd-daemon-handover.c
+@@ -55,6 +55,9 @@ struct _GrdDaemonHandover
+   GrdShellDialog *dialog;
+ 
+   unsigned int gnome_remote_desktop_watch_name_id;
++  unsigned int request_handover_retry_id;
++  unsigned int request_handover_retry_count;
++#define REQUEST_HANDOVER_MAX_RETRIES 30
+ };
+ 
+ G_DEFINE_TYPE (GrdDaemonHandover, grd_daemon_handover, GRD_TYPE_DAEMON)
+@@ -562,6 +565,34 @@ on_remote_desktop_rdp_handover_proxy_acq
+ static void
+ on_remote_desktop_rdp_dispatcher_handover_requested (GObject      *object,
+                                                      GAsyncResult *result,
++                                                     gpointer      user_data);
++
++static gboolean
++retry_request_handover (gpointer user_data)
++{
++  GrdDaemonHandover *daemon_handover = user_data;
++  GCancellable *cancellable;
++
++  daemon_handover->request_handover_retry_id = 0;
++
++  if (!daemon_handover->remote_desktop_dispatcher)
++    return G_SOURCE_REMOVE;
++
++  cancellable = grd_daemon_get_cancellable (GRD_DAEMON (daemon_handover));
++
++  g_debug ("[DaemonHandover] Retrying RequestHandover");
++  grd_dbus_remote_desktop_rdp_dispatcher_call_request_handover (
++    daemon_handover->remote_desktop_dispatcher,
++    cancellable,
++    on_remote_desktop_rdp_dispatcher_handover_requested,
++    daemon_handover);
++
++  return G_SOURCE_REMOVE;
++}
++
++static void
++on_remote_desktop_rdp_dispatcher_handover_requested (GObject      *object,
++                                                     GAsyncResult *result,
+                                                      gpointer      user_data)
+ {
+   GrdDBusRemoteDesktopRdpDispatcher *remote_desktop_dispatcher;
+@@ -583,8 +614,47 @@ on_remote_desktop_rdp_dispatcher_handove
+       if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+         return;
+ 
+-      g_warning ("[DaemonHandover] Failed to request remote desktop "
+-                 "handover: %s", error->message);
++      daemon_handover = GRD_DAEMON_HANDOVER (user_data);
++
++      daemon_handover->request_handover_retry_count++;
++
++      if (daemon_handover->request_handover_retry_count <=
++          REQUEST_HANDOVER_MAX_RETRIES)
++        {
++          /* Initial retries: every 2 seconds for the first 60s.
++           * This handles the normal case where the system daemon
++           * needs a moment to set up the session. */
++          g_debug ("[DaemonHandover] Failed to request remote desktop "
++                   "handover: %s, retrying in 2s (%u/%d)",
++                   error->message,
++                   daemon_handover->request_handover_retry_count,
++                   REQUEST_HANDOVER_MAX_RETRIES);
++
++          if (daemon_handover->request_handover_retry_id == 0)
++            {
++              daemon_handover->request_handover_retry_id =
++                g_timeout_add_seconds (2, retry_request_handover,
++                                       daemon_handover);
++            }
++        }
++      else
++        {
++          /* After initial retries exhausted, keep retrying every 10s.
++           * The handover daemon may start before any client connects
++           * (e.g. after a GDM restart). It must remain available for
++           * future connections rather than permanently giving up. */
++          g_debug ("[DaemonHandover] Failed to request remote desktop "
++                   "handover: %s, slow-retrying in 10s (%u)",
++                   error->message,
++                   daemon_handover->request_handover_retry_count);
++
++          if (daemon_handover->request_handover_retry_id == 0)
++            {
++              daemon_handover->request_handover_retry_id =
++                g_timeout_add_seconds (10, retry_request_handover,
++                                       daemon_handover);
++            }
++        }
+       return;
+     }
+ 
+@@ -730,6 +800,9 @@ grd_daemon_handover_shutdown (GApplicati
+ 
+   g_cancellable_cancel (grd_daemon_get_cancellable (daemon));
+ 
++  g_clear_handle_id (&daemon_handover->request_handover_retry_id,
++                     g_source_remove);
++
+   g_clear_object (&daemon_handover->remote_desktop_handover);
+   g_clear_object (&daemon_handover->remote_desktop_dispatcher);
+ 
+--- gnome-remote-desktop-49.0.orig/src/grd-session-rdp.c
++++ gnome-remote-desktop-49.0/src/grd-session-rdp.c
+@@ -1274,15 +1274,35 @@ init_rdp_session (GrdSessionRdp  *sessio
+                                          rdp_private_key, 1))
+     g_assert_not_reached ();
+ 
+-  freerdp_settings_set_bool (rdp_settings, FreeRDP_RdpSecurity, FALSE);
+-  freerdp_settings_set_bool (rdp_settings, FreeRDP_TlsSecurity, FALSE);
+-  freerdp_settings_set_bool (rdp_settings, FreeRDP_NlaSecurity, TRUE);
+-
+   if (grd_context_get_runtime_mode (context) == GRD_RUNTIME_MODE_HANDOVER)
+     {
++      /* Handover mode: offer RDSTLS + TLS, no NLA.
++       * The handover daemon has no SAM database for NLA/NTLM auth.
++       * Clients that support RDSTLS (redirected auth) use it;
++       * others (like mstsc) fall back to TLS. The user was already
++       * authenticated during the initial connection to the system daemon. */
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_RdpSecurity, FALSE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_TlsSecurity, TRUE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_NlaSecurity, FALSE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_RdstlsSecurity, TRUE);
+       freerdp_settings_set_string (rdp_settings, FreeRDP_Username, username);
+       freerdp_settings_set_string (rdp_settings, FreeRDP_Password, password);
+-      freerdp_settings_set_bool (rdp_settings, FreeRDP_RdstlsSecurity, TRUE);
++    }
++  else if (grd_context_get_runtime_mode (context) == GRD_RUNTIME_MODE_SYSTEM)
++    {
++      /* System mode: offer TLS + NLA for initial connections.
++       * Some clients (mstsc CredSSP v6) may fail NLA on first attempt
++       * but auto-retry; TLS provides a reliable fallback. */
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_RdpSecurity, FALSE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_TlsSecurity, TRUE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_NlaSecurity, TRUE);
++    }
++  else
++    {
++      /* Headless/screen-share modes: NLA only (original behavior) */
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_RdpSecurity, FALSE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_TlsSecurity, FALSE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_NlaSecurity, TRUE);
+     }
+ 
+   freerdp_settings_set_uint32 (rdp_settings, FreeRDP_OsMajorType,
+--- /dev/null
++++ gnome-remote-desktop-49.0/tests/test-mstsc-patches.sh
+@@ -0,0 +1,125 @@
++#!/bin/sh
++# Test suite for mstsc handover patches (LP #2141992)
++# Tests that FAIL on unpatched GRD and PASS on patched GRD.
++#
++# Usage: ./test-mstsc-patches.sh [--unpatched]
++#   --unpatched  Expect unpatched behavior (tests assert failures)
++
++PASS=0
++FAIL=0
++SKIP=0
++EXPECT_UNPATCHED=false
++
++if [ "$1" = "--unpatched" ]; then
++  EXPECT_UNPATCHED=true
++fi
++
++GRD_BINARY="${GRD_BINARY:-/usr/libexec/gnome-remote-desktop-daemon}"
++HANDOVER_SERVICE="${HANDOVER_SERVICE:-${TEST_SRCDIR:-/tmp/gnome-remote-desktop-49.0}/data/gnome-remote-desktop-handover.service.in}"
++GRD_SESSION_RDP_SOURCE="${GRD_SESSION_RDP_SOURCE:-${TEST_SRCDIR:-/tmp/gnome-remote-desktop-49.0}/src/grd-session-rdp.c}"
++GRD_DAEMON_HANDOVER_SOURCE="${GRD_DAEMON_HANDOVER_SOURCE:-${TEST_SRCDIR:-/tmp/gnome-remote-desktop-49.0}/src/grd-daemon-handover.c}"
++
++pass() { echo "  PASS: $1"; PASS=$((PASS + 1)); }
++fail() { echo "  FAIL: $1"; FAIL=$((FAIL + 1)); }
++skip() { echo "  SKIP: $1"; SKIP=$((SKIP + 1)); }
++
++assert_patched() {
++  # $1 = test name, $2 = condition (0=true, nonzero=false)
++  if [ "$2" -eq 0 ]; then
++    if [ "$EXPECT_UNPATCHED" = "true" ]; then
++      fail "$1 (expected to fail on unpatched, but passed)"
++    else
++      pass "$1"
++    fi
++  else
++    if [ "$EXPECT_UNPATCHED" = "true" ]; then
++      pass "$1 (correctly fails on unpatched)"
++    else
++      fail "$1"
++    fi
++  fi
++}
++
++echo "=== Bug 1: SYSTEM mode offers TLS alongside NLA ==="
++# The patched code should have TlsSecurity = TRUE in the SYSTEM mode branch.
++# Unpatched code only has NlaSecurity = TRUE with TlsSecurity = FALSE.
++if [ -f "$GRD_SESSION_RDP_SOURCE" ]; then
++  # Check source: SYSTEM mode branch should set TlsSecurity TRUE
++  SYSTEM_TLS=$(awk '/RUNTIME_MODE_SYSTEM/,/\}/' "$GRD_SESSION_RDP_SOURCE" | \
++    grep -c "FreeRDP_TlsSecurity, TRUE" || true)
++  SYSTEM_TLS=${SYSTEM_TLS:-0}
++  test "$SYSTEM_TLS" -ge 1
++  assert_patched "SYSTEM mode enables TLS in source" $?
++else
++  # Check binary: look for the string pattern indicating TLS is configured
++  # alongside the SYSTEM mode runtime check
++  strings "$GRD_BINARY" | grep -q "TLS.*fallback\|TLS + NLA" 2>/dev/null
++  skip "Source not available, binary string check inconclusive"
++fi
++
++echo ""
++echo "=== Bug 2: HANDOVER mode disables NLA and enables TLS ==="
++# Note: Stock GRD already sets RDSTLS=TRUE in HANDOVER mode, but keeps
++# NLA=TRUE and TLS=FALSE. NLA fails without a SAM/NTLM provider after
++# redirect. Our patch disables NLA and enables TLS in HANDOVER mode.
++if [ -f "$GRD_SESSION_RDP_SOURCE" ]; then
++  # Check source: HANDOVER mode should disable NLA
++  HANDOVER_NO_NLA=$(awk '/RUNTIME_MODE_HANDOVER/,/\}/' "$GRD_SESSION_RDP_SOURCE" | \
++    grep -c "FreeRDP_NlaSecurity, FALSE" || true)
++  HANDOVER_NO_NLA=${HANDOVER_NO_NLA:-0}
++  test "$HANDOVER_NO_NLA" -ge 1
++  assert_patched "HANDOVER mode disables NLA in source" $?
++
++  # Check source: HANDOVER mode should enable TLS
++  HANDOVER_TLS=$(awk '/RUNTIME_MODE_HANDOVER/,/\}/' "$GRD_SESSION_RDP_SOURCE" | \
++    grep -c "FreeRDP_TlsSecurity, TRUE" || true)
++  HANDOVER_TLS=${HANDOVER_TLS:-0}
++  test "$HANDOVER_TLS" -ge 1
++  assert_patched "HANDOVER mode enables TLS in source" $?
++else
++  skip "Source not available for Bug 2 checks"
++fi
++
++echo ""
++echo "=== Bug 3: Handover service has RefuseManualStop ==="
++if [ -f "$HANDOVER_SERVICE" ]; then
++  grep -q "RefuseManualStop=yes" "$HANDOVER_SERVICE" 2>/dev/null
++  assert_patched "Handover service has RefuseManualStop=yes" $?
++else
++  skip "Handover service file not found at $HANDOVER_SERVICE"
++fi
++
++echo ""
++echo "=== Bug 4: Handover daemon retries RequestHandover ==="
++if [ -f "$GRD_DAEMON_HANDOVER_SOURCE" ]; then
++  # Check that retry logic exists
++  grep -q "retry_request_handover" "$GRD_DAEMON_HANDOVER_SOURCE" 2>/dev/null
++  assert_patched "Handover daemon has retry function" $?
++
++  # Check that it doesn't permanently give up (slow-retry after initial window)
++  grep -q "slow-retrying\|slow.retry\|keep retrying" "$GRD_DAEMON_HANDOVER_SOURCE" 2>/dev/null
++  assert_patched "Handover daemon has slow-retry fallback (no permanent give-up)" $?
++else
++  skip "Handover daemon source not available for Bug 4 checks"
++fi
++
++echo ""
++echo "=== Bug 4b: Integration test -- handover retry with xfreerdp3 ==="
++if command -v xfreerdp3 >/dev/null 2>&1 && [ -n "$DISPLAY" ] && systemctl is-active gnome-remote-desktop >/dev/null 2>&1; then
++  # Test that the system daemon accepts a TLS connection
++  # On unpatched GRD, this will fail (NLA only, no TLS)
++  RESULT=$(timeout 8 xfreerdp3 /v:127.0.0.1 /u:ubuntu /p:ubuntu \
++    /sec:tls /cert:tofu +clipboard /timeout:5000 2>&1 || true)
++
++  echo "$RESULT" | grep -q "server_redirection_pdu\|redirection\|PIXEL_FORMAT" 2>/dev/null
++  assert_patched "xfreerdp3 TLS connection reaches redirect or desktop" $?
++else
++  skip "xfreerdp3 not available, no DISPLAY, or GRD not running"
++fi
++
++echo ""
++echo "======================================="
++echo "Results: $PASS passed, $FAIL failed, $SKIP skipped"
++echo "======================================="
++
++[ "$FAIL" -eq 0 ]
diff -Nru gnome-remote-desktop-49.0/debian/patches/series gnome-remote-desktop-49.0/debian/patches/series
--- gnome-remote-desktop-49.0/debian/patches/series	2025-10-14 03:44:18.000000000 -0400
+++ gnome-remote-desktop-49.0/debian/patches/series	2026-02-21 03:03:10.000000000 -0500
@@ -1,2 +1,3 @@
 fdkaac.patch
 lp-2127792-fix-nvenc-blackwell.patch
+lp-2141992-mstsc-handover-fix.patch
