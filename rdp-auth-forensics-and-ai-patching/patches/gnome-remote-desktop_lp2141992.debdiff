diff -Nru gnome-remote-desktop-49.0/debian/changelog gnome-remote-desktop-49.0/debian/changelog
--- gnome-remote-desktop-49.0/debian/changelog	2025-10-14 03:44:18.000000000 -0400
+++ gnome-remote-desktop-49.0/debian/changelog	2026-02-17 06:30:00.000000000 -0500
@@ -1,3 +1,16 @@
+gnome-remote-desktop (49.0-0ubuntu1.2) questing; urgency=medium
+
+  * d/p/lp-2141992-fix-mstsc-handover-negotiation.patch:
+    Fix RDP handover with Windows mstsc on headless VMs (LP: #2141992)
+    - HANDOVER mode: disable NLA (no SAM database), offer RDSTLS + TLS
+    - SYSTEM mode: add TLS fallback alongside NLA for CredSSP resilience
+    - Handover service: add RefuseManualStop=yes to prevent gsd-sharing
+      from killing the handover daemon in GDM greeter sessions
+    - Handover daemon: retry RequestHandover on failure instead of giving
+      up, so post-login handover succeeds when client reconnects
+
+ -- Ubuntu User <ubuntu@localhost>  Mon, 17 Feb 2026 06:30:00 -0500
+
 gnome-remote-desktop (49.0-0ubuntu1.1) questing; urgency=medium
 
   * d/p/lp-2127792-fix-nvenc-blackwell.patch: Fix NVENC video streaming on 
diff -Nru gnome-remote-desktop-49.0/debian/patches/lp-2141992-fix-mstsc-handover-negotiation.patch gnome-remote-desktop-49.0/debian/patches/lp-2141992-fix-mstsc-handover-negotiation.patch
--- gnome-remote-desktop-49.0/debian/patches/lp-2141992-fix-mstsc-handover-negotiation.patch	1969-12-31 19:00:00.000000000 -0500
+++ gnome-remote-desktop-49.0/debian/patches/lp-2141992-fix-mstsc-handover-negotiation.patch	2026-02-17 06:30:00.000000000 -0500
@@ -0,0 +1,176 @@
+Description: Fix RDP security negotiation for mstsc handover connections
+ Four issues prevent Windows mstsc.exe from completing an RDP session
+ to GRD on headless VMs:
+ .
+ Bug 1 (SYSTEM mode): Only NLA is offered. mstsc's CredSSP v6 pubKeyAuth
+ binding sometimes fails on first attempt. Adding TLS as a fallback
+ (matching Windows RDS "Negotiate" behavior) provides a reliable path.
+ .
+ Bug 2 (HANDOVER mode): NLA is offered but the handover daemon has no SAM
+ database for NTLM validation. Since mstsc does not request RDSTLS,
+ negotiation selects NLA which fails with SEC_E_NO_CREDENTIALS.
+ Fix: disable NLA in handover mode, keep RDSTLS + TLS.
+ .
+ Bug 3 (gsd-sharing): gnome-settings-daemon's sharing plugin stops
+ gnome-remote-desktop-handover.service ~2s after start because the GDM
+ greeter user has no enabled-connections in gsettings. Adding
+ RefuseManualStop=yes prevents this while allowing normal session teardown.
+ .
+ Bug 4 (handover retry): The user-session handover daemon calls
+ RequestHandover once on startup. If no mstsc connection is pending yet
+ (e.g. the user just logged in via GDM and the client hasn't reconnected),
+ the call fails and the daemon never retries. Fix: schedule a 2-second
+ retry on RequestHandover failure (up to 30 attempts / 60 seconds) so
+ the handover completes once the client's redirected connection arrives.
+Author: Claude Code <noreply@anthropic.com>
+Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/gnome-remote-desktop/+bug/2141992
+Forwarded: https://gitlab.gnome.org/GNOME/gnome-remote-desktop/-/issues/244
+Last-Update: 2026-02-17
+---
+This patch header follows DEP-3: http://dep.debian.net/deps/dep3/
+--- a/src/grd-session-rdp.c
++++ b/src/grd-session-rdp.c
+@@ -1274,15 +1274,35 @@
+                                          rdp_private_key, 1))
+     g_assert_not_reached ();
+
+-  freerdp_settings_set_bool (rdp_settings, FreeRDP_RdpSecurity, FALSE);
+-  freerdp_settings_set_bool (rdp_settings, FreeRDP_TlsSecurity, FALSE);
+-  freerdp_settings_set_bool (rdp_settings, FreeRDP_NlaSecurity, TRUE);
+-
+   if (grd_context_get_runtime_mode (context) == GRD_RUNTIME_MODE_HANDOVER)
+     {
++      /* Handover mode: offer RDSTLS + TLS, no NLA.
++       * The handover daemon has no SAM database for NLA/NTLM auth.
++       * Clients that support RDSTLS (redirected auth) use it;
++       * others (like mstsc) fall back to TLS. The user was already
++       * authenticated during the initial connection to the system daemon. */
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_RdpSecurity, FALSE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_TlsSecurity, TRUE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_NlaSecurity, FALSE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_RdstlsSecurity, TRUE);
+       freerdp_settings_set_string (rdp_settings, FreeRDP_Username, username);
+       freerdp_settings_set_string (rdp_settings, FreeRDP_Password, password);
+-      freerdp_settings_set_bool (rdp_settings, FreeRDP_RdstlsSecurity, TRUE);
++    }
++  else if (grd_context_get_runtime_mode (context) == GRD_RUNTIME_MODE_SYSTEM)
++    {
++      /* System mode: offer TLS + NLA for initial connections.
++       * Some clients (mstsc CredSSP v6) may fail NLA on first attempt
++       * but auto-retry; TLS provides a reliable fallback. */
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_RdpSecurity, FALSE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_TlsSecurity, TRUE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_NlaSecurity, TRUE);
++    }
++  else
++    {
++      /* Headless/screen-share modes: NLA only (original behavior) */
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_RdpSecurity, FALSE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_TlsSecurity, FALSE);
++      freerdp_settings_set_bool (rdp_settings, FreeRDP_NlaSecurity, TRUE);
+     }
+
+   freerdp_settings_set_uint32 (rdp_settings, FreeRDP_OsMajorType,
+--- a/src/grd-daemon-handover.c
++++ b/src/grd-daemon-handover.c
+@@ -55,6 +55,9 @@
+   GrdShellDialog *dialog;
+
+   unsigned int gnome_remote_desktop_watch_name_id;
++  unsigned int request_handover_retry_id;
++  unsigned int request_handover_retry_count;
++#define REQUEST_HANDOVER_MAX_RETRIES 30
+ };
+
+ G_DEFINE_TYPE (GrdDaemonHandover, grd_daemon_handover, GRD_TYPE_DAEMON)
+@@ -562,6 +565,34 @@
+ static void
+ on_remote_desktop_rdp_dispatcher_handover_requested (GObject      *object,
+                                                      GAsyncResult *result,
++                                                     gpointer      user_data);
++
++static gboolean
++retry_request_handover (gpointer user_data)
++{
++  GrdDaemonHandover *daemon_handover = user_data;
++  GCancellable *cancellable;
++
++  daemon_handover->request_handover_retry_id = 0;
++
++  if (!daemon_handover->remote_desktop_dispatcher)
++    return G_SOURCE_REMOVE;
++
++  cancellable = grd_daemon_get_cancellable (GRD_DAEMON (daemon_handover));
++
++  g_debug ("[DaemonHandover] Retrying RequestHandover");
++  grd_dbus_remote_desktop_rdp_dispatcher_call_request_handover (
++    daemon_handover->remote_desktop_dispatcher,
++    cancellable,
++    on_remote_desktop_rdp_dispatcher_handover_requested,
++    daemon_handover);
++
++  return G_SOURCE_REMOVE;
++}
++
++static void
++on_remote_desktop_rdp_dispatcher_handover_requested (GObject      *object,
++                                                     GAsyncResult *result,
+                                                      gpointer      user_data)
+ {
+   GrdDBusRemoteDesktopRdpDispatcher *remote_desktop_dispatcher;
+@@ -583,8 +614,30 @@
+       if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+         return;
+
+-      g_warning ("[DaemonHandover] Failed to request remote desktop "
+-                 "handover: %s", error->message);
++      daemon_handover = GRD_DAEMON_HANDOVER (user_data);
++
++      if (daemon_handover->request_handover_retry_count >=
++          REQUEST_HANDOVER_MAX_RETRIES)
++        {
++          g_warning ("[DaemonHandover] Failed to request remote desktop "
++                     "handover after %u retries, giving up: %s",
++                     daemon_handover->request_handover_retry_count,
++                     error->message);
++          return;
++        }
++
++      daemon_handover->request_handover_retry_count++;
++      g_debug ("[DaemonHandover] Failed to request remote desktop "
++               "handover: %s, retrying in 2s (%u/%d)",
++               error->message,
++               daemon_handover->request_handover_retry_count,
++               REQUEST_HANDOVER_MAX_RETRIES);
++
++      if (daemon_handover->request_handover_retry_id == 0)
++        {
++          daemon_handover->request_handover_retry_id =
++            g_timeout_add_seconds (2, retry_request_handover, daemon_handover);
++        }
+       return;
+     }
+
+@@ -730,6 +783,9 @@
+
+   g_cancellable_cancel (grd_daemon_get_cancellable (daemon));
+
++  g_clear_handle_id (&daemon_handover->request_handover_retry_id,
++                     g_source_remove);
++
+   g_clear_object (&daemon_handover->remote_desktop_handover);
+   g_clear_object (&daemon_handover->remote_desktop_dispatcher);
+
+--- a/data/gnome-remote-desktop-handover.service.in
++++ b/data/gnome-remote-desktop-handover.service.in
+@@ -1,5 +1,10 @@
+ [Unit]
+ Description=GNOME Remote Desktop Handover
++# Prevent gsd-sharing from stopping the handover service on the login screen.
++# gsd-sharing calls DisableService when enabled-connections is empty for the
++# gdm greeter user, but the handover daemon must remain active in greeter
++# sessions for the system daemon's server redirection to complete.
++RefuseManualStop=yes
+
+ [Service]
+ Type=dbus
diff -Nru gnome-remote-desktop-49.0/debian/patches/series gnome-remote-desktop-49.0/debian/patches/series
--- gnome-remote-desktop-49.0/debian/patches/series	2025-10-14 03:44:18.000000000 -0400
+++ gnome-remote-desktop-49.0/debian/patches/series	2026-02-17 06:30:00.000000000 -0500
@@ -1,2 +1,3 @@
 fdkaac.patch
 lp-2127792-fix-nvenc-blackwell.patch
+lp-2141992-fix-mstsc-handover-negotiation.patch
