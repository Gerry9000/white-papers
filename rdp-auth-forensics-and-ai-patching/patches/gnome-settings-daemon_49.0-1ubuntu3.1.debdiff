diff -Nru gnome-settings-daemon-49.0/debian/changelog gnome-settings-daemon-49.0/debian/changelog
--- gnome-settings-daemon-49.0/debian/changelog	2025-09-26 08:05:46.000000000 -0400
+++ gnome-settings-daemon-49.0/debian/changelog	2026-02-21 10:48:58.000000000 -0500
@@ -1,3 +1,16 @@
+gnome-settings-daemon (49.0-1ubuntu3.1) questing; urgency=medium
+
+  * Fix gsd-sharing stopping handover service while system RDP daemon is
+    active (LP: #2141992)
+    - gsd-sharing unconditionally stops gnome-remote-desktop-handover.service
+      during pre_shutdown, even when the system gnome-remote-desktop daemon
+      is still running and needs the handover service for active RDP sessions
+    - Check system_service_running before stopping assigned services
+    - Only stop the handover service when the system daemon is no longer
+      on the bus
+
+ -- Gerry Burde <gerry.burde@gmail.com>  Fri, 21 Feb 2026 14:00:00 -0500
+
 gnome-settings-daemon (49.0-1ubuntu3) questing; urgency=medium
 
   * d/maintscript: Remove obsolete autostart desktop files
diff -Nru gnome-settings-daemon-49.0/debian/patches/lp-2141992-gsd-sharing-handover-fix.patch gnome-settings-daemon-49.0/debian/patches/lp-2141992-gsd-sharing-handover-fix.patch
--- gnome-settings-daemon-49.0/debian/patches/lp-2141992-gsd-sharing-handover-fix.patch	1969-12-31 19:00:00.000000000 -0500
+++ gnome-settings-daemon-49.0/debian/patches/lp-2141992-gsd-sharing-handover-fix.patch	2026-02-21 14:00:00.000000000 -0500
@@ -0,0 +1,35 @@
+Description: Don't stop handover service when system RDP daemon is running
+ gsd-sharing unconditionally stops gnome-remote-desktop-handover.service
+ when sharing_status transitions to OFFLINE. This kills active RDP sessions
+ when the system gnome-remote-desktop daemon still needs the handover
+ service. Add a guard checking system_service_running before stopping.
+Author: Gerry Burde <gerry.burde@gmail.com>
+Bug-Ubuntu: https://bugs.launchpad.net/bugs/2141992
+Bug: https://gitlab.gnome.org/GNOME/gnome-settings-daemon/-/issues/931
+Forwarded: https://gitlab.gnome.org/GNOME/gnome-settings-daemon/-/issues/931
+Last-Update: 2026-02-21
+---
+Index: gnome-settings-daemon-49.0/plugins/sharing/gsd-sharing-manager.c
+===================================================================
+--- gnome-settings-daemon-49.0.orig/plugins/sharing/gsd-sharing-manager.c
++++ gnome-settings-daemon-49.0/plugins/sharing/gsd-sharing-manager.c
+@@ -402,10 +402,16 @@ gsd_sharing_manager_sync_assigned_servic
+         for (l = services; l != NULL; l = l->next) {
+                 AssignedServiceInfo *info = l->data;
+ 
+-                if (manager->sharing_status == GSD_SHARING_STATUS_OFFLINE)
+-                        stop_assigned_service (manager, info);
+-                else
++                if (manager->sharing_status == GSD_SHARING_STATUS_OFFLINE) {
++                        /* Don't stop the assigned user service if its
++                         * corresponding system service is still running.
++                         * The system daemon may still need the handover
++                         * service for active RDP sessions. */
++                        if (!info->system_service_running)
++                                stop_assigned_service (manager, info);
++                } else {
+                         start_assigned_service (manager, info);
++                }
+         }
+         g_list_free (services);
+ #endif
diff -Nru gnome-settings-daemon-49.0/debian/patches/series gnome-settings-daemon-49.0/debian/patches/series
--- gnome-settings-daemon-49.0/debian/patches/series	2025-09-26 08:05:46.000000000 -0400
+++ gnome-settings-daemon-49.0/debian/patches/series	2026-02-21 14:00:00.000000000 -0500
@@ -6,3 +6,4 @@
 ubuntu/lid-close-suspend-support.patch
 ubuntu/keyboard-Use-ibus-sources-from-locale.patch
 ubuntu/teach-gsd-about-the-gnome-calculator-snap-.desktop-name.patch
+lp-2141992-gsd-sharing-handover-fix.patch
